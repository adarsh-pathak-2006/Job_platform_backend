# Security
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=True

# Allowed Hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1,.yourdomain.com
CORS_ALLOW_ALL_ORIGINS=True
# Or specify origins explicitly if CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourfrontend.com

# Database (Neon PostgreSQL)
# Example: postgres://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Caching (Upstash Redis)
# Example: redis://default:[password]@[upstash_hostname]:[port]
REDIS_URL=
